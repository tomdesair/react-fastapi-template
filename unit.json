{
  "listeners": {
    "*:80": {
      "pass": "routes"
    }
  },
  "applications": {
    "fastapi": {
      "type": "python3",
      "path": "/app",
      "module": "backend.server",
      "callable": "app",
      "user": "unit",
      "group": "unit"
    }
  },
  "routes": [
    {
      "match": {
        "uri": "/api/*"
      },
      "action": {
        "pass": "applications/fastapi"
      }
    },
    {
      "action": {
        "share": "/app/frontend$uri",
        "types": ["image/*", "font/*", "text/*", "application/*"]
      }
    }
  ]
}
